{
  "expo": {
    "name": "E9 Mate Myanmar",
    "slug": "e9-severance-calculator",
    "scheme": "e9severance",
    "version": "0.1.3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "package": "com.e9mate.myanmar",
      "allowBackup": false,
      "icon": "./assets/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-system-ui",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 128,
          "resizeMode": "contain",
          "backgroundColor": "#F4F8FF",
          "dark": {
            "backgroundColor": "#0B1425"
          }
        }
      ],
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-7752680457121386~8251446871",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "69189198-1f10-48e8-9ee6-9d32d2a8cb68"
      }
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/69189198-1f10-48e8-9ee6-9d32d2a8cb68",
      "enabled": true,
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
