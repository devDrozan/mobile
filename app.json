{
  "expo": {
    "name": "E9 Mate Myanmar",
    "slug": "e9-severance-calculator",
    "scheme": "e9severance",
    "version": "0.1.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#123c35",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.e9mate.myanmar",
      "allowBackup": false
    },
    "plugins": [
      "expo-router",
      "expo-system-ui",
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 128,
          "resizeMode": "contain",
          "backgroundColor": "#f7f8f4",
          "dark": {
            "backgroundColor": "#101a16"
          }
        }
      ],
      [
  "expo-sqlite",
  {
    "useSQLCipher": true
  }
],
      [
  "react-native-google-mobile-ads",
  {
    "androidAppId": "ca-app-pub-7752680457121386~8251446871",
    "iosAppId": "ca-app-pub-3940256099942544~1458002511"
  }
]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "69189198-1f10-48e8-9ee6-9d32d2a8cb68"
      }
    }
  }
}
